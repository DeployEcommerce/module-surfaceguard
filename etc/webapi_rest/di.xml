<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Declared on the service contract so guest-carts and carts/mine are both covered,
        and scoped to REST so a storefront add-to-cart is answered by its own guard rather
        than this one.
    -->
    <type name="Magento\Quote\Api\CartItemRepositoryInterface">
        <plugin name="deployecommerce_surfaceguard_cart_item_file_option"
                type="DeployEcommerce\SurfaceGuard\Plugin\DenyCartItemFileOption"
                sortOrder="10"/>
    </type>
</config>
